# ============================================================================
# Castvoo settings. In Railway: your service → Variables → paste each line.
# Only the REQUIRED block is needed to start. Everything else switches on a
# feature; leave it out and that feature stays hidden until you add it.
# ============================================================================

# ---------- REQUIRED ----------
# Railway fills this in when you add a PostgreSQL database (use ${{Postgres.DATABASE_URL}}).
DATABASE_URL=
# 64 random characters. Generate with:  openssl rand -hex 32   NEVER change it after launch
# (it encrypts bot tokens and signs links).
APP_SECRET=
# Your public address, with https:// and no slash at the end.
APP_URL=https://castvoo.com
# The email that becomes platform Owner when it first logs in (you).
OWNER_EMAIL=
NODE_ENV=production

# ---------- Telegram (@CastvooBot, needed for channels, groups and Telegram login) ----------
# Create the bot with @BotFather (/newbot). Then send /setdomain to BotFather with your domain
# (castvoo.com) so "Log in with Telegram" works.
CASTVOO_BOT_TOKEN=
CASTVOO_BOT_USERNAME=CastvooBot
# Optional: a random string for Telegram webhooks. Made from APP_SECRET if empty.
TELEGRAM_WEBHOOK_SECRET=
# Messages per second per bot. Telegram allows about 30. Keep 25.
TG_SEND_PER_SECOND=25

# ---------- Email (Resend.com) ----------
# Without a key, emails are only written to the logs (login codes won't arrive!).
RESEND_API_KEY=
# Must be on a domain you verified in Resend.
EMAIL_FROM=Castvoo <hello@castvoo.com>
EMAIL_REPLY_TO=support@castvoo.com
# Leave empty (auto). "log" forces log-only.
EMAIL_PROVIDER=

# ---------- Cas AI (console.anthropic.com) ----------
ANTHROPIC_API_KEY=

# ---------- Payments ----------
# Paystack (Nigeria, Ghana, South Africa). Dashboard → Settings → API Keys & Webhooks.
# Webhook URL to paste in Paystack: https://YOUR-DOMAIN/pay/paystack
PAYSTACK_SECRET_KEY=
# Flutterwave (Kenya, Cameroon, cards everywhere). Settings → API keys, and Settings → Webhooks:
# URL https://YOUR-DOMAIN/pay/flutterwave and a "Secret hash" you choose; put the same hash here.
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
# Gatevoo crypto checkout (USDT + Bitcoin). In Gatevoo: Connect → Add an app → copy the key and
# webhook secret. Webhook URL: https://YOUR-DOMAIN/pay/gatevoo
# Without Gatevoo, crypto still works in manual mode (Admin → Settings → wallet addresses).
GATEVOO_URL=https://gatevoo.com
GATEVOO_KEY=
GATEVOO_WEBHOOK_SECRET=

# ---------- Google login (optional) ----------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- VooSquare (the Zedapex account hub) · Voo Connect ----------
# "Continue with Voo ID" login, the affiliate hand-off (?ref= &vclick= &coupon=), money events (commission), the
# support widget and "log out everywhere". Uses the kit in ./voo-connect (copied unchanged from VooSquare's
# sdk/voo-connect). Guide: docs/INTEGRATIONS.md → VooSquare.
# The three credentials come from VooSquare → Admin → Products → Castvoo → Credentials. In VooSquare also set:
#   URL https://YOUR-DOMAIN · SSO on · Redirect URIs (two lines, exact): https://YOUR-DOMAIN/auth/voosquare/callback
#   and https://YOUR-DOMAIN/ · Summary URL https://YOUR-DOMAIN/api/voosquare/summary
#   · Support webhook https://YOUR-DOMAIN/hooks/voosquare/support
VOO_BASE=https://voosquare.com
VOO_CLIENT_ID=
VOO_CLIENT_SECRET=
# Used both ways: Castvoo → VooSquare (events, support messages) and VooSquare → Castvoo (summary, support desk).
VOO_API_KEY=
# A long random string you make once (openssl rand -hex 32) and NEVER change. It hashes fraud hints sent to VooSquare.
VOO_SIGNAL_SECRET=
# Optional: a private address for server-to-server calls to VooSquare. Leave empty otherwise.
VOO_SERVER_BASE=
# The switch for all of the above: off = no Voo ID button, no hand-off, no events, no widget (other logins keep working).
VOO_CONNECT=on
# The VooSquare support widget on the public website (replaces the help bubble there). off = keep our own bubble.
VOO_SUPPORT_WIDGET=on
# Optional: a second key VooSquare may use to call Castvoo (two-way support desk).
VOO_SERVICE_KEY=
# Older name for VOO_BASE (still read).
# VOO_ISSUER=

# ---------- Server (defaults are fine on Railway) ----------
# Railway sets PORT itself.
# PORT=3000
# Where uploaded photos/videos are stored. Mount a Railway Volume at /data.
UPLOAD_DIR=/data/uploads
# Database connections per server.
DB_POOL_MAX=15
# Run the background workers (sending, follow-ups, billing) in this service.
RUN_WORKERS=true
# Trust the last X-Forwarded-For address (the one our proxy adds) for rate limits. Default: on when
# RAILWAY_ENVIRONMENT is set (Railway's edge adds the real address), off elsewhere. Set false when nothing
# in front of Castvoo appends X-Forwarded-For, or visitors could pick their own IP.
TRUST_PROXY=true
# Set by Railway itself (do not set it by hand); only used for the TRUST_PROXY default.
# RAILWAY_ENVIRONMENT=

# ---------- Only for tests (leave empty in production) ----------
# TELEGRAM_API_BASE=
# RESEND_API_BASE=
# ANTHROPIC_API_BASE=
# PAYSTACK_API_BASE=
# FLW_API_BASE=
# GOOGLE_ISSUER=
